# parse mail
MAIL_SERVER_NAME=server.name

MAIL_1_ADDRESS=mail_1.address
MAIL_1_USERNAME=mail_1.username
MAIL_1_PASSWORD=mail_1.password

MAIL_2_ADDRESS=mail_2.address
MAIL_2_USERNAME=mail_2.username
MAIL_2_PASSWORD=mail_2.password

# получатели отчётов валидации (validate_gpb / validate_rsd)
GPB_VALIDATION_RECIPIENT=
RSD_VALIDATION_RECIPIENT=

# auto settings
USE_AUTODISCOVER=False

# cifs users
CIFS_USERNAME=cifs.user
CIFS_PASSWORD=cifs.password
SECOND_CIFS_USERNAME=second.cifs.user
SECOND_CIFS_PASSWORD=second.cifs.password

# folders (SOURCE_DIR в file_handler = REPORS_DEPO_DIRECTORY + DECODE)
REPORS_DEPO_DIRECTORY=/mnt/share/direct_1/direct_2
DECODE="0 DECODE"
DOMRF_OPEN_DIR=
DOMRFIA_OPEN_DIR=
DOMRF_SECRET_DIR=/mnt/share/path/to/DOMRF/secret
DOMRFIA_SECRET_DIR=/mnt/share/path/to/DOMRFIA/secret
# каталог назначения для copy_I_msg_files (раньше ./!Загрузка в ЕИС)
EIS_DIR=/mnt/share/.../!Загрузка в ЕИС
# каталог назначения для copy_REP_xls_files (раньше ./Залог АСВ/Отчеты)
REPORTS_DIR=/mnt/share/.../Залог АСВ/Отчеты
